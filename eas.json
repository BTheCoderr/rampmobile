{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview-android": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_RAMP_DIRECTORY_URL": ""
      }
    },
    "preview-ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_RAMP_DIRECTORY_URL": ""
      }
    },
    "preview-ios-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_RAMP_DIRECTORY_URL": ""
      }
    }
  }
}
