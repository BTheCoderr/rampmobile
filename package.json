{
  "name": "rampmobile",
  "private": true,
  "version": "0.4.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "validate-data": "node scripts/validate-data.mjs",
    "test:unit": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:bundle:ios": "expo export --platform ios --output-dir /tmp/rampmobile-ios-export",
    "check:bundle:android": "expo export --platform android --output-dir /tmp/rampmobile-android-export",
    "check:expo-compatibility": "expo install --check"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-status-bar": "~3.0.9",
    "react-native-safe-area-context": "~5.6.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-maps": "1.20.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
